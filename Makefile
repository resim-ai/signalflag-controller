HELM ?= helm
KUSTOMIZE ?= kustomize
CHART := charts/signalflag-controller
BASE := kustomize/base/signalflag-controller.yaml

.PHONY: help
help: ## Show the targets.
	@awk 'BEGIN {FS = ":.*##"} /^[a-z-]+:.*##/ { printf "  %-10s %s\n", $$1, $$2 }' $(MAKEFILE_LIST)

.PHONY: lint
lint: ## Lint the chart.
	$(HELM) lint --strict $(CHART)

.PHONY: kustomize
kustomize: ## Render kustomize/base from the chart's default values.
	{ echo '# Code generated by make kustomize from $(CHART). DO NOT EDIT.'; \
	  $(HELM) template signalflag-controller $(CHART) --namespace respawn-system; } > $(BASE)

.PHONY: check
check: kustomize ## Fail if kustomize/base doesn't match the chart.
	@git diff --exit-code -- kustomize/base || { echo 'kustomize/base is stale: run make kustomize and commit the result.'; exit 1; }

.PHONY: build
build: ## Build the Kustomize base and overlays.
	$(KUSTOMIZE) build kustomize/base > /dev/null
	$(KUSTOMIZE) build kustomize/overlays/kind > /dev/null
