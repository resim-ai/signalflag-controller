{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environments", "controller", "poolHandler", "protectCRDs"],
  "properties": {
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 50
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "concurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "poolHandler": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 51
        },
        "replicas": { "type": "integer", "minimum": 0 }
      }
    },
    "protectCRDs": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "blockBulkDelete": { "type": "boolean" }
      }
    }
  }
}
